# India In-Time — environment variables
# Copy this file to .env for local development. On Render (or any host),
# set these as real environment variables in the dashboard instead.
#
# Every var below was found by grepping the codebase for process.env.* —
# this file intentionally does not include DB_PATH or NOMINATIM_* vars from
# an earlier draft; those turned out to be dead config no code reads
# (see config/index.js history / the audit notes if you want the details).

# ── Required ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Postgres connection string (Neon). Use the pooled connection string
# (contains "-pooler." or "?pgbouncer=true") — db/init.js warns at startup
# if you paste the non-pooled one by mistake.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Google Gemini API key — required, the app will refuse to start in
# production without it (see config/index.js requireEnv()).
GEMINI_API_KEY=

# Firebase service account credentials, as JSON — used to verify user auth
# tokens (middleware/auth.js). Paste the full service-account JSON as-is,
# OR base64-encode it first if your host mangles multi-line env vars.
FIREBASE_SERVICE_ACCOUNT=

# ── Optional — server ────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=*
BODY_LIMIT=5mb

# Number of cluster worker processes. Leave unset — server.js picks a safe
# default on its own (1, unless REDIS_URL is set, see below). Only override
# this if you know what you're doing; see the comment above numCPUs in
# server.js before raising it without REDIS_URL set.
# CLUSTER_WORKERS=1

# ── Optional — Redis (distributed rate limiting) ────────────────────────
# Without this, rate limiting is per-worker in-memory, which is fine as
# long as CLUSTER_WORKERS stays at 1 (the default). Set this to run more
# than one worker safely — middleware/rateLimiter.js will automatically
# switch to a shared Redis-backed counter, and server.js will allow
# CLUSTER_WORKERS to scale to all CPU cores. Also enables a background
# write-through/warm-on-miss layer on top of services/cache.js's
# places/gemini/weather/geocode caches, so a value cached by one
# instance/worker can be picked up by another — get()/set() stay fully
# synchronous either way; a Redis outage silently degrades to today's
# in-memory-only behavior.
# REDIS_URL=redis://localhost:6379

# ── Optional — Gemini tuning ─────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.5-flash
# Tried once, only after every retry against GEMINI_MODEL is exhausted, and
# only for retryable failures (network/429/5xx). Real protection against one
# specific model being overloaded/rate-limited/deprecated — not a substitute
# for true multi-provider failover. Set to '' to disable.
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Optional second Gemini API key from a SEPARATE Google Cloud project/billing
# account. Covers that project hitting its own quota/rate limit or its
# billing/auth getting suspended independently — NOT a different provider,
# so a full Gemini/Google outage still takes both keys down. Tried only
# after GEMINI_MODEL on the primary key has exhausted all retries; skips
# GEMINI_FALLBACK_MODEL on the primary key and goes straight to this key
# with GEMINI_MODEL, then tries GEMINI_FALLBACK_MODEL on this key too if
# that also fails. Leave unset to disable.
# GEMINI_API_KEY_SECONDARY=
# GEMINI_MAX_RETRIES=3
# GEMINI_TIMEOUT_MS=20000
# GEMINI_IMAGE_TIMEOUT_MS=30000
# GEMINI_MAX_CONCURRENT=5

# ── Optional — rate limits (requests/minute/IP) ──────────────────────────
# RATE_LIMIT_AI=15
# RATE_LIMIT_PLACES=10
# RATE_LIMIT_WEATHER=60
# RATE_LIMIT_GENERAL=100

# ── Optional — cache ──────────────────────────────────────────────────────
# CACHE_MAX_ENTRIES=500
# CACHE_PLACES_TTL_MS=1800000
# CACHE_WEATHER_TTL_MS=300000
# CACHE_GEMINI_TTL_MS=600000

# ── Optional — database pool ──────────────────────────────────────────────
# DB_POOL_MAX=8

# ── Optional — map tiles ──────────────────────────────────────────────────
# MapTiler API key (https://cloud.maptiler.com — free tier, no card needed,
# 100k map loads/month). Optional: without it, the frontend falls back to
# CARTO's and OSM's free anonymous tile endpoints (see TILE_SOURCES in
# app.js), which work but are shared/rate-limited demo infrastructure and
# can throttle under real traffic. Restrict this key to your domain in the
# MapTiler dashboard once set — it's exposed to the browser via /api/config
# by design (it goes into a public tile request URL either way).
# MAPTILER_KEY=

# ── Optional — admin feedback dashboard ───────────────────────────────────
# Protects /api/feedback and /api/analytics admin-only endpoints
# (see middleware/adminAuth.js). Two ways to authenticate as an admin:
#
#   1. PREFERRED: a Firebase ID token from a user with the `admin: true`
#      custom claim (Authorization: Bearer <token>). This attributes every
#      admin request to a real user instead of "whoever has the key". Grant
#      it via the Firebase Admin SDK, e.g. in a one-off script:
#        admin.auth().setCustomUserClaims(uid, { admin: true });
#
#   2. Legacy shared secret below (x-admin-key header) — kept for backward
#      compatibility with frontend/public/admin-feedback.html. Leave unset
#      to disable this fallback path entirely (Firebase-claim admins still
#      work without it).
# ADMIN_FEEDBACK_KEY=
#
#   Once ADMIN_FEEDBACK_KEY is set, every successful legacy-key auth logs a
#   DEPRECATED warning (grep your logs for it) so you can see whether
#   anything actually still depends on this path. When you're confident
#   nothing does, set this to fully disable it WITHOUT unsetting/redeploying
#   ADMIN_FEEDBACK_KEY itself — flip it back to false instantly if that
#   turns out to be wrong.
# ADMIN_LEGACY_KEY_DISABLED=false
