{
  "name": "india-in-time-backend",
  "version": "2.0.0",
  "description": "Backend API server for India In-Time travel app — production-grade fullstack",
  "main": "server.js",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "backup": "node scripts/backup-db.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern frontend/public",
    "lint:fix": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern frontend/public --fix",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "build:frontend": "node scripts/build-frontend.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ]
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
